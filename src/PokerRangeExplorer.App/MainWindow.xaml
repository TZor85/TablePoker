        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Poker Range Explorer" Height="800" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel izquierdo --><!--
        <Border Grid.Column="0" Background="LightGray" Padding="10">
            <StackPanel>
                <Button Name="LoadFilesButton" Content="Cargar JSONs" Click="LoadFiles_Click" Margin="0,0,0,5"/>
                <Button Name="LoadDirectoryButton" Content="Cargar Carpeta" Click="LoadDirectory_Click" Margin="0,0,0,10"/>

                <TextBlock Text="Rangos Cargados:" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox Name="RangeListBox" SelectionChanged="RangeList_SelectionChanged" Height="350"/>

                <StackPanel Margin="0,10,0,0">
                    <TextBlock Name="StatusText" FontWeight="Bold" Foreground="Green"/>
                    <TextBlock Name="ErrorText" FontWeight="Bold" Foreground="Red" TextWrapping="Wrap"/>
